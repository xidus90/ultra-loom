# Work traces of plan execution: intermediate states of commits that follow.
docs/.superpowers/sdd/
# The sdd-workspace script of the plugin still writes here; sweep to docs/.
/.superpowers/

__pycache__/
*.py[cod]
.venv/
.mypy_cache/
.dmypy.json
.ruff_cache/
.coverage
htmlcov/

# Isolated workspaces for plan execution.
/.worktrees/

# Run journals are traces of single runs, not source.
.ultraloom/runs/

# Per-session hook state: a block counter and remote snapshots, worthless to
# anyone but the session that wrote them.
.ultraloom/hooks/

# The init binary is built, not written.
/ultraloom-init
/ultraloom-init.exe
# `go build ./cmd/init` names its output after the directory, so the binary
# lands here under this name too unless someone passes -o.
/init
/init.exe
/ulinit
/ulinit.exe
/ulguard
/ulguard.exe
/ulguard_*.exe
/ulinit_*.exe

# Temporary files and test profiles
/*.out
/*.cov
/coverage
/coverage.out
/cover
/guard_cover
/cov_*.out

# Local brain & wiki hook cache
.ultra-brain/


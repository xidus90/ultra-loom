# generated from .ultraloom/answers.toml -- edit that and re-run init
[project]
commit_language = {{ quote .Answers.Project.CommitLanguage }}

# Reported, not enforced: the threshold that bites is `fail_under` in the
# project's own coverage configuration, and init does not write there.
[verify.coverage]
threshold = {{ .Answers.Gates.CoverageThreshold }}

[verify.profiles]
edit      = {{ list .EditKinds }}
precommit = {{ list .PrecommitKinds }}

# Which checks a changed path is worth. An extension that does not appear here
# draws the full chain: a gate that skips checks unnoticed is worse than none.
[relevance]
{{ range $pattern := keys .Answers.Relevance }}{{ quote $pattern }} = {{ list (index $.Answers.Relevance $pattern) }}
{{ end }}

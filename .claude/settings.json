{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}/.venv/Scripts/ultraloom.exe\" policy hook --root \"${CLAUDE_PROJECT_DIR}\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
